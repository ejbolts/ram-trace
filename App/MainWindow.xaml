<Window x:Class="RamTrace.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RamTrace"
 Title="RamTrace" Width="1220" Height="880" MinWidth="1040" MinHeight="780" WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="13">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
  <Style x:Key="MutedText" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/><Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Hover}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="CaretBrush" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/><Setter Property="Padding" Value="10,8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/><Setter Property="Padding" Value="10,8"/><Setter Property="MinWidth" Value="100"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="6"><TextBlock Text="⌄" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Margin="10,8,28,8" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"><Border MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" Padding="4"><ScrollViewer MaxHeight="300"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Padding" Value="10,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="B" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Hover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,6"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,8"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger></Style.Triggers></Style>
  <Style TargetType="DataGridRow"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Hover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="182"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,1,0">
   <DockPanel Margin="18,28,18,20">
    <StackPanel DockPanel.Dock="Top">
     <StackPanel Orientation="Horizontal" Margin="4,0,0,5"><Border Background="{DynamicResource Accent}" Width="27" Height="27" CornerRadius="7" Margin="0,0,9,0"><TextBlock Text="≋" Foreground="White" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-7,0,0"/></Border><TextBlock Text="RamTrace" FontSize="21" FontWeight="SemiBold"/></StackPanel>
     <Border Height="25"/>
     <Button x:Name="OverviewNav" Content="◷   Overview" HorizontalContentAlignment="Left" Click="Overview_Click" Background="{DynamicResource AccentSoft}" BorderBrush="Transparent" Margin="0,0,0,8"/>
     <Button x:Name="SettingsNav" Content="⚙   Settings" Click="Settings_Click" Background="Transparent" BorderBrush="Transparent"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
     <Border Background="{DynamicResource Surface}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"><StackPanel><TextBlock x:Name="StatusLabel" Text="●  Connecting" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/><TextBlock x:Name="IntervalLabel" Text="Every 30 seconds" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0"/><Button x:Name="PauseButton" Content="Pause logging" Click="Pause_Click" FontSize="11" Padding="8,6" Margin="0,12,0,0"/></StackPanel></Border>
     
     
    </StackPanel>
    <Grid/>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="28,23,28,16" x:Name="OverviewPage">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="Export CSV  ↗" Click="Export_Click" VerticalAlignment="Top"/><StackPanel><TextBlock Text="Memory overview" FontSize="26" FontWeight="SemiBold"/></StackPanel></DockPanel>
   <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12">
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,10,0"><StackPanel><TextBlock Text="SYSTEM RAM · LATEST" FontSize="10" Style="{StaticResource MutedText}" FontWeight="SemiBold"/><TextBlock x:Name="UsedValue" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,5"/><TextBlock x:Name="UsedHint" Text="Waiting for the first sample" FontSize="11" Style="{StaticResource MutedText}"/></StackPanel></Border>
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,10,0"><StackPanel><TextBlock Text="DEDICATED VRAM · LATEST" FontSize="10" Style="{StaticResource MutedText}" FontWeight="SemiBold"/><TextBlock x:Name="PeakValue" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,5"/><TextBlock x:Name="PeakHint" Text="Peaks preserved in history" FontSize="11" Style="{StaticResource MutedText}"/></StackPanel></Border>
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="10" Padding="14,10"><StackPanel><TextBlock Text="APPS OBSERVED · IN RANGE" FontSize="10" Style="{StaticResource MutedText}" FontWeight="SemiBold"/><TextBlock x:Name="AppsValue" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,5"/><TextBlock x:Name="AppsHint" Text="Grouped by executable name" FontSize="11" Style="{StaticResource MutedText}"/></StackPanel></Border>
   </UniformGrid>
   <StackPanel Grid.Row="2" Margin="0,0,0,12">
    <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><ComboBox x:Name="RangeBox" Width="132" SelectedIndex="0" SelectionChanged="Filter_Changed" AutomationProperties.Name="Time range"><ComboBoxItem Content="Last hour"/><ComboBoxItem Content="Last 6 hours"/><ComboBoxItem Content="Last 24 hours"/><ComboBoxItem Content="Last 7 days"/><ComboBoxItem Content="Last 30 days"/><ComboBoxItem Content="All history"/><ComboBoxItem Content="Custom range"/></ComboBox><ComboBox x:Name="MetricBox" Width="215" SelectedIndex="0" Margin="8,0,0,0" SelectionChanged="Filter_Changed" AutomationProperties.Name="Memory metric"><ComboBoxItem Content="Working set (RAM)"/><ComboBoxItem Content="Private bytes (commit)"/><ComboBoxItem Content="Dedicated GPU memory"/><ComboBoxItem Content="Shared GPU memory"/><ComboBoxItem Content="GPU activity (%)"/></ComboBox></StackPanel><TextBlock Text="All times are local" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
    <StackPanel x:Name="CustomRangePanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,10,0,0"><TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,6,0"/><DatePicker x:Name="FromDate" Width="130"/><TextBox x:Name="FromTime" Text="00:00" Width="65" Margin="5,0,12,0" AutomationProperties.Name="From time HH:mm"/><TextBlock Text="To" VerticalAlignment="Center" Margin="0,0,6,0"/><DatePicker x:Name="ToDate" Width="130"/><TextBox x:Name="ToTime" Text="23:59" Width="65" Margin="5,0,10,0" AutomationProperties.Name="To time HH:mm"/><Button Content="Apply range" Click="ApplyRange_Click"/></StackPanel>
   </StackPanel>
   <Border Grid.Row="3" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,17">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel><Button x:Name="GraphToggle" DockPanel.Dock="Right" Content="Hide graph ⌃" Click="GraphToggle_Click" Padding="9,5" FontSize="11" Margin="8,0,0,0"/><Button x:Name="ResetButton" Content="↶  System total" Click="Reset_Click" DockPanel.Dock="Right" Padding="9,5" FontSize="11" Visibility="Collapsed"/><StackPanel><TextBlock x:Name="ChartTitle" Text="System memory" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="ChartSubtitle" Text="Solid: average usage   ·   Dashed: sampled peak" FontSize="11" Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel></DockPanel>
     <local:MemoryChart x:Name="Chart" Grid.Row="1" Height="135" Margin="0,5,0,0"/>
     <TextBlock Grid.Row="2" x:Name="ChartHint" Text="Select an app below to explore its timeline. Hover the graph for exact values." FontSize="11" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
    </Grid>
   </Border>
   <Grid Grid.Row="4" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
    <TextBox x:Name="SearchBox" ToolTip="Search executable names" AutomationProperties.Name="Search apps" TextChanged="Search_Changed" Margin="0,0,8,0"/>
    <TextBlock Text="Search apps…" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource Muted}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <ComboBox Grid.Column="1" x:Name="ActivityBox" SelectedIndex="0" SelectionChanged="ListFilter_Changed" Margin="0,0,8,0" AutomationProperties.Name="Activity filter"><ComboBoxItem Content="All observed apps"/><ComboBoxItem Content="In latest sample"/></ComboBox>
    <ComboBox Grid.Column="2" x:Name="MinimumBox" SelectedIndex="0" SelectionChanged="ListFilter_Changed" AutomationProperties.Name="Minimum peak"><ComboBoxItem Content="Any peak usage"/><ComboBoxItem Content="Peak ≥ 100 MB"/><ComboBoxItem Content="Peak ≥ 500 MB"/><ComboBoxItem Content="Peak ≥ 1 GB"/></ComboBox>
   </Grid>
   <Grid Grid.Row="5"><DataGrid x:Name="AppGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" HeadersVisibility="Column" GridLinesVisibility="None" RowHeaderWidth="0" SelectionMode="Single" SelectionUnit="FullRow" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" SelectionChanged="App_Selected" EnableRowVirtualization="True" EnableColumnVirtualization="True" RowHeight="30" AutomationProperties.Name="App memory history">
    <DataGrid.Columns><DataGridTextColumn Header="Application" Binding="{Binding Name}" SortMemberPath="Name" Width="*" MinWidth="180"/><DataGridTextColumn Header="Latest" Binding="{Binding LatestText}" SortMemberPath="Latest" Width="103"/><DataGridTextColumn Header="Avg while seen" Binding="{Binding AverageText}" SortMemberPath="Average" Width="122"/><DataGridTextColumn Header="Peak" Binding="{Binding PeakText}" SortMemberPath="Peak" Width="104"/><DataGridTextColumn Header="Peak at" Binding="{Binding PeakTimeText}" SortMemberPath="PeakTime" Width="155"/><DataGridTextColumn Header="Last seen" Binding="{Binding LastSeenText}" SortMemberPath="LastSeen" Width="155"/></DataGrid.Columns>
   </DataGrid><TextBlock x:Name="EmptyLabel" Text="Your history starts here. Waiting for the first sample…" Visibility="Collapsed" Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
   <TextBlock Grid.Row="6" x:Name="Footer" Text="Connecting to the background logger…" FontSize="11" Style="{StaticResource MutedText}" Margin="0,11,0,0" TextWrapping="Wrap"/>
  </Grid>
  <ScrollViewer Grid.Column="1" x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
   <StackPanel Margin="32,26,32,28" MaxWidth="850" HorizontalAlignment="Left">
    <TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold"/><Border Height="20"/>
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="10" Padding="23"><StackPanel>
     <TextBlock Text="Appearance" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Follow Windows, or pick a theme for RamTrace." Style="{StaticResource MutedText}" Margin="0,7,0,13"/><ComboBox x:Name="ThemeBox" Width="210" HorizontalAlignment="Left" SelectionChanged="Theme_Changed" AutomationProperties.Name="Theme"><ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox>
     <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Margin="0,24,0,21"/>
     <TextBlock Text="Background logging" FontSize="17" FontWeight="SemiBold"/><CheckBox x:Name="StartupCheck" Content="Start RamTrace when I sign in to Windows" Checked="Startup_Changed" Unchecked="Startup_Changed" Margin="0,15,0,7"/><TextBlock Text="Starts quietly in the tray. Closing this window keeps logging." Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,19"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Sample interval" Margin="0,0,0,8"/><ComboBox x:Name="IntervalBox" Width="210" HorizontalAlignment="Left" SelectionChanged="SettingsValue_Changed" AutomationProperties.Name="Sample interval"><ComboBoxItem Content="10 seconds · default"/><ComboBoxItem Content="15 seconds"/><ComboBoxItem Content="30 seconds"/><ComboBoxItem Content="60 seconds"/><ComboBoxItem Content="2 minutes"/></ComboBox></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Keep history for" Margin="0,0,0,8"/><ComboBox x:Name="RetentionBox" Width="200" HorizontalAlignment="Left" SelectionChanged="SettingsValue_Changed" AutomationProperties.Name="History retention"><ComboBoxItem Content="Forever"/><ComboBoxItem Content="7 days"/><ComboBoxItem Content="30 days"/><ComboBoxItem Content="90 days"/></ComboBox></StackPanel></Grid>
     <TextBlock Text="Forever keeps your history without automatic expiry. Disk usage grows over time.&#10;Short-lived spikes between samples can be missed." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,15,0,0" LineHeight="20"/>
    </StackPanel></Border>
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="10" Padding="23" Margin="0,18,0,0"><StackPanel>
     <TextBlock Text="Storage and GPUs" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="History is stored on this computer. GPU memory and activity are recorded alongside RAM." Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="21" Margin="0,10,0,12"/>
     <CheckBox x:Name="CompactCheck" Content="Summarize history after 48 hours (five-minute averages and peaks)" Checked="Compact_Changed" Unchecked="Compact_Changed" Margin="0,0,0,14"/><TextBlock x:Name="GpuDevicesLabel" TextWrapping="Wrap" Margin="0,0,0,14"/><TextBlock x:Name="StorageLabel" TextWrapping="Wrap" FontSize="12"/><Button Content="Open data folder  ↗" Click="DataFolder_Click" HorizontalAlignment="Left" Margin="0,13,0,0"/>
    </StackPanel></Border>
    <TextBlock Text="Understanding the numbers" FontSize="16" FontWeight="SemiBold" Margin="0,25,0,10"/>
    <TextBlock Text="Working set is RAM currently resident for an app, including shared pages. Private bytes is committed private memory and may include paged-out memory. Apps are grouped by executable name. Shared pages, Windows, and the kernel mean app totals do not equal system RAM. Protected or exited processes may be unavailable.&#10;&#10;Dedicated GPU memory is VRAM; shared GPU memory uses system RAM. GPU values cover all adapters. GPU activity is the busiest engine for the system; app activity sums the busiest engine of each process, capped at 100%, so it is an estimate. Windows/driver counters can differ from Task Manager. Unavailable counters remain gaps.&#10;&#10;The app list shows the latest sample in your selected range, average usage while an app was observed, and its largest sampled peak. Gaps mean RamTrace was paused, stopped, or Windows was asleep." Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="21"/>
    <TextBlock x:Name="SettingsFeedback" Margin="0,18,0,0" Foreground="{DynamicResource Accent}" TextWrapping="Wrap"/>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>
