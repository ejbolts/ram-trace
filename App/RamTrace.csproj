<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><ImplicitUsings>disable</ImplicitUsings><Nullable>enable</Nullable>
    <StartupObject>RamTrace.Program</StartupObject><AssemblyName>RamTrace</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version><Description>A lightweight, local Windows memory journal</Description>
    <!-- The shared WPF/WinForms host intentionally declares DPI awareness in its manifest. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Core/RamTrace.Core.csproj" /></ItemGroup>
</Project>
